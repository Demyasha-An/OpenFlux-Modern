<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_ambient">

    <LinearLayout
        android:id="@+id/configSelector"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/configDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dropdown_dot"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tunnelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="220dp"
            tools:text="My Tunnel" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/configSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Tap to connect" />

    <!-- в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ Center: aurora + rings + button в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
    <FrameLayout
        android:id="@+id/center"
        android:layout_width="360dp"
        android:layout_height="360dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <io.github.demyasha.openflux.ui.widget.AuroraView
            android:id="@+id/aurora"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center" />

        <io.github.demyasha.openflux.ui.widget.PulseRingsView
            android:id="@+id/pulseRings"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/ringOuter"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <View
            android:id="@+id/ringMid"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_mid" />

        <FrameLayout
            android:id="@+id/connectButton"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/powerIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_power"
                android:alpha="0.92"
                app:tint="@color/text_primary" />

        </FrameLayout>

    </FrameLayout>

    <!-- в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ Bottom: uptime в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
    <TextView
        android:id="@+id/uptimeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.18"
        android:text="@string/uptime_label"
        android:textAllCaps="true"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/uptimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/state_running"
        android:textSize="32sp"
        android:letterSpacing="0.06"
        android:alpha="0.0"
        app:layout_constraintTop_toBottomOf="@id/uptimeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="00:42" />

    <!-- в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ Bottom bar в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchButton"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_weight="1"
            android:text="@string/switch_tunnel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/bg_card_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_swap"
            app:iconTint="@color/text_secondary"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_weight="1"
            android:text="@string/add_tunnel_short"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/bg_card_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_add_qr"
            app:iconTint="@color/text_secondary"
            app:iconGravity="textStart"
            app:iconPadding="6dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
